# Copy to .env and fill in.
POSTGRES_PASSWORD=change-me
# Leave empty to rely on Tailscale for access control; set to require a login.
WORKBENCH_PASSWORD=
# Any long random string; signs the login cookie.
WORKBENCH_SECRET=change-me-too
# With a password set, the sign-in screen also offers View only (read, no changes, no password).
# Set to 0 to turn that off.
WORKBENCH_VIEW_ONLY=1
# Sign out after this many minutes without activity (0 = never). Sessions also end when the browser closes.
WORKBENCH_IDLE_MINUTES=30
# 1 = a refresh or new tab asks for the password again; 0 = stay signed in until idle or browser close.
WORKBENCH_LOGIN_EACH_LOAD=1
# Host interface and port for the app.
WORKBENCH_BIND=127.0.0.1
WORKBENCH_PORT=8080
