# Copy to .env and fill in.
POSTGRES_PASSWORD=change-me
# Leave empty to rely on Tailscale for access control; set to require a login.
WORKBENCH_PASSWORD=
# Any long random string; signs the login cookie.
WORKBENCH_SECRET=change-me-too
# Host interface and port for the app.
WORKBENCH_BIND=127.0.0.1
WORKBENCH_PORT=8080
